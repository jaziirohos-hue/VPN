# Public DNS name of the API server (Caddy requests the HTTPS certificate for it)
API_DOMAIN=api.example.com
# Long random secret for the admin endpoints. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me
# DNS servers handed to phones while connected
VPN_DNS=1.1.1.1,1.0.0.1
PEER_TTL_DAYS=30
DEVICE_TTL_DAYS=180
# Many phones on Somali mobile networks share one public IP (CGNAT), so keep this generous
REGISTER_LIMIT_PER_HOUR=200
# Shown on https://API_DOMAIN/privacy (the privacy policy link for Google Play)
PRIVACY_CONTACT=Contact us through the Xalane VPN listing on Google Play.
PRIVACY_EFFECTIVE_DATE=10 November 2026
