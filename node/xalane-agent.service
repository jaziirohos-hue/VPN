[Unit]
Description=Xalane VPN node agent
After=network-online.target wg-quick@wg0.service
Wants=network-online.target
Requires=wg-quick@wg0.service

[Service]
EnvironmentFile=/etc/xalane/agent.env
ExecStart=/usr/bin/python3 /opt/xalane/xalane-agent.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
