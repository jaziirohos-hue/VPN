# Public DNS name of the API server (Caddy requests the HTTPS certificate for it)
API_DOMAIN=api.example.com
# Long random secret for the admin endpoints. Generate one with: openssl rand -hex 32
ADMIN_TOKEN=change-me
# DNS servers handed to phones while connected
VPN_DNS=1.1.1.1,1.0.0.1
PEER_TTL_DAYS=30
DEVICE_TTL_DAYS=180
REGISTER_LIMIT_PER_HOUR=20
